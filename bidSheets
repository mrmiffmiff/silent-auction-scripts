function generateBidSheets() {
    // Open the Google Sheet
    const sheet = SpreadsheetApp.openById('INSERTID').getSheetByName('Events');
    const data = sheet.getDataRange().getValues().filter(row => row[0]);

    // Create a new Google Document
    let doc = DocumentApp.create("Silent Auction Bid Sheets Attempt 5 03/27/2025");
    const id = doc.getId();
    doc.saveAndClose();

    // Loop through each row of data (skip the header row)
    for (let i = 1; i < data.length; i++) {
        const row = data[i];
        const eventName = row[0];
        const eventNumber = row[2];
        const eventDescription = row[4];
        const eventDetails = row[5];
        const donorDisplayName = row[10];
        const quantity = row[11];
        const startingBid = row[14];
        const bidIncrement = row[15];
        const sheetType = row[16];
        const value = row[13];
        const descriptor = row[12];

        doc = DocumentApp.openById(id);
        const body = doc.getBody();

        // Add the event header
        body.appendParagraph(`${eventNumber}. ${eventName}`)
            .setHeading(DocumentApp.ParagraphHeading.HEADING1)
            .setAlignment(DocumentApp.HorizontalAlignment.CENTER)
            .setBold(true);

        // Add the event description
        body.appendParagraph(eventDescription)
            .setAlignment(DocumentApp.HorizontalAlignment.CENTER)
            .setBold(false);

        // Add the event details
        if (eventDetails) {
            body.appendParagraph(`Details: ${eventDetails}`)
                .setAlignment(DocumentApp.HorizontalAlignment.CENTER)
                .setBold(true);
        }

        if (value != 'priceless') {
            body.appendParagraph(`Value: $${value}`).setAlignment(DocumentApp.HorizontalAlignment.CENTER).setBold(true);
        }

        // Add the donor display name
        body.appendParagraph(`Thanks to: ${donorDisplayName}`)
            .setAlignment(DocumentApp.HorizontalAlignment.CENTER)
            .setBold(false);

        switch (sheetType) {
            case 'A':
                typeA(body, startingBid, bidIncrement);
                break;
            case 'B':
            case 'E':
                typeB(body, startingBid, bidIncrement, quantity, 0, descriptor);
                break;
            case 'C':
                typeC(body, startingBid, bidIncrement, quantity, descriptor);
                break;
            case 'F':
                typeF(body, startingBid, quantity);
                break;
        }

        // Add a page break after each item (except the last one)
        if (i < data.length - 1) {
            body.appendPageBreak();
        }

        doc.saveAndClose();
    }

    // Log the URL of the created document
    Logger.log(`Document created: ${doc.getUrl()}`);
}

