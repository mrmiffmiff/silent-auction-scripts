    const top1 = headerRow.appendTableCell("");
    top1.setPaddingLeft(0);
    top1.setPaddingTop(0);
    top1.setPaddingBottom(0);
    top1.setPaddingRight(0);
    const top2 = headerRow.appendTableCell("Bid");
    top2.setPaddingLeft(0);
    top2.setPaddingTop(0);
    top2.setPaddingBottom(0);
    top2.setPaddingRight(0);
    const top3 = headerRow.appendTableCell("Name");
    top3.setPaddingLeft(0);
    top3.setPaddingTop(0);
    top3.setPaddingBottom(0);
    top3.setPaddingRight(0);

    table.setColumnWidth(0, 30);
    table.setColumnWidth(1, 40);

    for (let j = 1; j <= quantity; j++) {
        const row = table.appendTableRow();
        const num = row.appendTableCell(j.toString()).setBold(true);
        const price = row.appendTableCell(`$${startingBid + (bidIncrement * (j - 1))}`);
        const name = row.appendTableCell("");
        row.setMinimumHeight(30);
    }

}

function typeB(body, startingBid, bidIncrement, quantity, incrementMultiplier, descriptor) {
    // Create the table
    const table = body.appendTable();
    const headerRow = table.appendTableRow();
    const perText = (descriptor) ? ` per ${descriptor}` : '';

    // Add column headers
    const first = headerRow.appendTableCell("").setBold(true); // Empty cell for row numbers
    first.setPaddingBottom(0);
    first.setPaddingLeft(0);
    first.setPaddingRight(0);
    first.setPaddingTop(0);
    for (let i = 0; i < 4; i++) {
        headerRow.appendTableCell(`$${startingBid + (bidIncrement * incrementMultiplier)}${perText}`).setBold(true);
        incrementMultiplier++;
    }

    table.setColumnWidth(0, 30);

    // Add rows for bids
    for (let j = 1; j <= quantity; j++) {
        const row = table.appendTableRow();
        row.appendTableCell(j.toString()).setBold(true); // Row number
        row.appendTableCell(""); // Blank cell for bid 1
        row.appendTableCell(""); // Blank cell for bid 2
        row.appendTableCell(""); // Blank cell for bid 3
        row.appendTableCell(""); // Blank cell for bid 4

        // Set row height (slightly taller)
        row.setMinimumHeight(30); // Adjust this value as needed
    }
}

function typeC(body, startingBid, bidIncrement, quantity, descriptor) {
    const numTables = (quantity < 4) ? 3 : 2;
    for (let i = 0; i < numTables; i++) {
        typeB(body, startingBid, bidIncrement, quantity, 4 * i, descriptor);
        if (!(i + 1 == numTables)) {
            body.appendParagraph("");
            body.appendParagraph("");
        }
    }
}

function typeD(body, startingBid, bidIncrement, quantity) {
    const table = body.appendTable();
    const headerRow = table.appendTableRow();
    const first = headerRow.appendTableCell("").setBold(true);
    first.setPaddingBottom(0);
    first.setPaddingLeft(0);
    first.setPaddingRight(0);
    first.setPaddingTop(0);
    headerRow.appendTableCell(`$${startingBid}`).setBold(true);
    headerRow.appendTableCell(`$${startingBid} continued`).setBold(true);
    headerRow.appendTableCell(`$${startingBid + bidIncrement}`).setBold(true);
    headerRow.appendTableCell(`$${startingBid + bidIncrement} continued`).setBold(true);
    table.setColumnWidth(0, 30);

    for (let j = 1; j <= quantity; j++) {
        const row = table.appendTableRow();
        row.appendTableCell(j.toString()).setBold(true);
        row.appendTableCell("");
        row.appendTableCell("");
        row.appendTableCell("");
        row.appendTableCell("");
        row.setMinimumHeight(30);
    }
}

